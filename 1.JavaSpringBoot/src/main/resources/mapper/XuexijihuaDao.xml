<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.XuexijihuaDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.XuexijihuaEntity" id="xuexijihuaMap">
        <result property="zhanghao" column="zhanghao"/>
        <result property="jihuabiaoti" column="jihuabiaoti"/>
        <result property="jihuaneirong" column="jihuaneirong"/>
        <result property="jihuatupian" column="jihuatupian"/>
        <result property="zhuangtai" column="zhuangtai"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.XuexijihuaView" >

		SELECT  xuexijihua.* FROM xuexijihua  xuexijihua 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.XuexijihuaView" >
		SELECT * FROM xuexijihua  xuexijihua <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.XuexijihuaView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
