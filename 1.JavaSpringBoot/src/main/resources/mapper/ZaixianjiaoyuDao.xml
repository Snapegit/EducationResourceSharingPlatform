<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ZaixianjiaoyuDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ZaixianjiaoyuEntity" id="zaixianjiaoyuMap">
        <result property="biaoti" column="biaoti"/>
        <result property="fenlei" column="fenlei"/>
        <result property="fabushijian" column="fabushijian"/>
        <result property="shipin" column="shipin"/>
        <result property="xiangqing" column="xiangqing"/>
        <result property="tupian" column="tupian"/>
        <result property="storeupnum" column="storeupnum"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ZaixianjiaoyuView" >

		SELECT  zaixianjiaoyu.* FROM zaixianjiaoyu  zaixianjiaoyu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ZaixianjiaoyuView" >
		SELECT * FROM zaixianjiaoyu  zaixianjiaoyu <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.ZaixianjiaoyuView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
